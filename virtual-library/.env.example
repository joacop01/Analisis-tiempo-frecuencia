# ── AI search (server-side only — never prefix these with VITE_) ─────────────
# Option A: Anthropic (preferred when set)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Option B: any OpenAI-compatible chat-completions API
# (OpenAI, Gemini, Groq, OpenRouter, Lovable gateway…)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#   Gemini:  OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  OPENAI_MODEL=gemini-2.5-flash
#   Lovable: OPENAI_BASE_URL=https://ai.gateway.lovable.dev/v1  OPENAI_MODEL=google/gemini-2.5-flash

# With neither key set, search falls back to plain keyword matching in the browser.

# ── Recommendations shelf (optional, public anon key is safe in the browser) ─
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
